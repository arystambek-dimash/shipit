{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:8000/internal/tls-ask
	}
}

{$APP_DOMAIN} {
	encode zstd gzip
	@internal path /internal/*
	respond @internal 404
	# Only the two upload routes take large bodies. Everything else is a small form or a Google ID
	# token, and the app parses those bodies in memory: a 60 MB JSON body costs it hundreds of MB.
	@upload path /deploy /sites/*/deploy
	request_body @upload {
		max_size 60MB
	}
	@not_upload not path /deploy /sites/*/deploy
	request_body @not_upload {
		max_size 64KB
	}
	reverse_proxy app:8000
}

*.{$SITES_DOMAIN} {
	tls {
		on_demand
	}
	import sites.caddy
}
